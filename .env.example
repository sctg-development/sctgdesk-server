# ------------------------
# HBBR (Relay Server)
# ------------------------

# Maximum bandwidth per single client (Mb/s)
# This sets the maximum speed that one client connection can use
SINGLE_BANDWIDTH=25

# Maximum total bandwidth for the relay server (Mb/s)
# This limits the total combined throughput of all clients
TOTAL_BANDWIDTH=1000

# Bandwidth limit for blocked IPs (Mb/s)
# Maximum speed allowed for connections coming from blacklisted IP addresses
LIMIT_SPEED=50

# Threshold for bandwidth downgrade (percentage of TOTAL_BANDWIDTH)
# When the total relay load exceeds this percentage of TOTAL_BANDWIDTH,
# hbbr will start reducing the speed of active connections
DOWNGRADE_THRESHOLD=66

# Delay before checking bandwidth downgrade (seconds)
# Time to wait before applying the downgrade check
DOWNGRADE_START_CHECK=1800

# Port on which HBBR listens for relay connections
#PORT=21117

# Secret key for relay server authentication
#KEY=MY_SECRET_KEY

# Path to file containing blacklisted IPs
#BLACKLIST_FILE=/data/blacklist.txt

# Alternative file for blocked IP addresses
#BLOCKLIST_FILE=/data/blocklist.txt

# Logging level
#RUST_LOG=info

# ------------------------
# HBBS (Rendezvous / Signal Server)
# ------------------------

# Port on which HBBS listens for client connections
#PORT=21116

# Path to the SQLite database file
#DB_URL=/data/db.sqlite

# Force all connections through relay (disable direct P2P)
#ALWAYS_USE_RELAY=Y

# Maximum number of concurrent connections to the database
#MAX_DATABASE_CONNECTIONS=5

# Comma-separated list of HBBR relay servers
#RELAY_SERVERS=relay.example.com:21117

# List of rendezvous servers for client discovery
#RENDEZVOUS_SERVERS=rendezvous.example.com:21116

# Server serial number / identifier
#SERIAL=server001

# UDP receive buffer size
#RMEM=8388608

# LAN mask for filtering connections
#MASK=255.255.255.0

# URL for client software or updates
#SOFTWARE_URL=https://example.com/rustdesk

# Test / health-check variable
#TEST_HBBS=1.2.3.4

# Logging level (error, warn, info, debug, trace)
#RUST_LOG=info
