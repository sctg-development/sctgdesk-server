#!/bin/sh /etc/rc.common
# procd init script of hbbr, the SCTGDesk relay server.
# Options come from /etc/config/sctgdesk-hbbr (UCI): see that file. Logs go to the system log (logread -e hbbr).
# Ports used: 21117 and 21119.
USE_PROCD=1
START=95
STOP=10

CONF=sctgdesk-hbbr
PROG=/usr/bin/hbbr

# one "list env" line of the UCI file = one environment variable of the program
append_env() {
	procd_append_param env "$1"
}

start_service() {
	local enabled datadir args
	config_load "$CONF"
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get datadir main datadir /etc/sctgdesk-server
	config_get args main args ""

	# the key pair, the database and the secrets live here and are for root only
	mkdir -p "$datadir"
	chmod 700 "$datadir"

	procd_open_instance
	# SCTGDESK_DATA_DIR: the program moves to its data directory itself (procd has no setting for the working
	# directory, and a wrapper shell would make the system log call it "sh"). $args is split on purpose.
	procd_set_param command "$PROG" $args
	procd_set_param env SCTGDESK_DATA_DIR="$datadir" OAUTH2_CREATE_USER=1 S3CONFIG_FILE=s3config.toml OAUTH2_CONFIG_FILE=oauth2.toml
	config_list_foreach main env append_env
	procd_set_param limits nofile="1000000 1000000"
	# restart after a crash, forever, waiting 10 s between two attempts
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/$CONF
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
