# Options of the hbbs service (see /etc/init.d/sctgdesk-hbbs). Apply with: /etc/init.d/sctgdesk-hbbs restart
config sctgdesk 'main'
	option enabled '1'
	# Where the key pair, the database and the secrets are kept. The root filesystem of a router is flash memory
	# (limited writes): prefer a USB disk or an extroot, for example '/mnt/sda1/sctgdesk-server'.
	option datadir '/etc/sctgdesk-server'
	# Command line options, for example: '-r relay.example.com -k <your-key> --logged-in-only'
	# option args ''
	# One environment variable of the program per line, for example:
	# list env 'RUST_LOG=info'
