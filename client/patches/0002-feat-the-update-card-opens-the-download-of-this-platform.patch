From f7b03095e95533047124c2d746c4d9fc8a63250f Mon Sep 17 00:00:00 2001
From: sctg <sctg@localhost>
Date: Fri, 30 Oct 2026 18:40:51 +0100
Subject: [PATCH] feat: the update card opens the download of this platform

For upstream a branded client is a custom client and hides the update card.
Show it, and open the download page of our API server for this platform
(Windows 64 or 32 bits, Mac Intel or Apple Silicon) instead of rustdesk.com.
The in-app update stays off: upstream restricts it to GitHub releases.
---
 .../lib/desktop/pages/desktop_home_page.dart  | 11 +++++---
 flutter/lib/mobile/pages/connection_page.dart |  5 ++--
 src/common.rs                                 | 26 ++++++++++++++++++-
 3 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/flutter/lib/desktop/pages/desktop_home_page.dart b/flutter/lib/desktop/pages/desktop_home_page.dart
index 6d370cb..6802b2e 100644
--- a/flutter/lib/desktop/pages/desktop_home_page.dart
+++ b/flutter/lib/desktop/pages/desktop_home_page.dart
@@ -428,14 +428,17 @@ class _DesktopHomePageState extends State<DesktopHomePage>
   }
 
   Widget buildHelpCards(String updateUrl) {
-    if (!bind.isCustomClient() &&
-        updateUrl.isNotEmpty &&
+    // our client is a custom client for upstream, which hides the update card: here the card opens the
+    // download of this platform (updateUrl, from check_software_update in src/common.rs)
+    if (updateUrl.isNotEmpty &&
         !isCardClosed &&
         bind.mainUriPrefixSync().contains('rustdesk')) {
-      final isToUpdate = (isWindows || isMacOS) && bind.mainIsInstalled();
+      final isToUpdate =
+          !bind.isCustomClient() && (isWindows || isMacOS) && bind.mainIsInstalled();
       String btnText = isToUpdate ? 'Update' : 'Download';
       GestureTapCallback onPressed = () async {
-        final Uri url = Uri.parse('https://rustdesk.com/download');
+        final Uri url = Uri.parse(
+            bind.isCustomClient() ? updateUrl : 'https://rustdesk.com/download');
         await launchUrl(url);
       };
       if (isToUpdate) {
