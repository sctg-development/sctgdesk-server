diff --git a/src/common.rs b/src/common.rs
index 1d9a059..6dbfa63 100644
--- a/src/common.rs
+++ b/src/common.rs
@@ -1024,6 +1024,28 @@ pub fn check_software_update() {
     }
 }
 
+/// The page of our API server that redirects to the newest client of this platform (api-server,
+/// `/api/software/download/<key>`), or to its download page when there is no client for it.
+fn client_download_url(api: &str) -> String {
+    let key = if cfg!(target_os = "windows") {
+        if cfg!(target_arch = "x86") {
+            Some("w32")
+        } else if cfg!(target_arch = "x86_64") {
+            Some("w64")
+        } else {
+            None
+        }
+    } else if cfg!(target_os = "macos") {
+        Some(if cfg!(target_arch = "aarch64") { "osx-arm64" } else { "osx" })
+    } else {
+        None
+    };
+    match key {
+        Some(key) => format!("{}/api/software/download/{}", api, key),
+        None => format!("{}/api/software/download", api),
+    }
+}
+
 // The url is the one of our API server, which answers like api.rustdesk.com/version/latest.
 #[tokio::main(flavor = "current_thread")]
 pub async fn do_check_software_update() -> hbb_common::ResultType<()> {
@@ -1067,7 +1089,9 @@ pub async fn do_check_software_update() -> hbb_common::ResultType<()> {
         {
             let mut m = HashMap::new();
             m.insert("name", "check_software_update_finish");
-            m.insert("url", &response_url);
+            // what the update button opens: our API server sends the user to the download of this platform
+            let download_url = client_download_url(&api);
+            m.insert("url", &download_url);
             if let Ok(data) = serde_json::to_string(&m) {
                 let _ = crate::flutter::push_global_event(crate::flutter::APP_TYPE_MAIN, data);
             }
