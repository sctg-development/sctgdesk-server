From 87e1179cac29e39c0710950e09b5929049c4d9e2 Mon Sep 17 00:00:00 2001
From: sctg <sctg@localhost>
Date: Wed, 11 Nov 2026 14:13:41 +0100
Subject: [PATCH 1/3] feat: check for updates on our API server

Upstream skips the update check for custom clients and posts to api.rustdesk.com.
Post the same request to our API server instead (POST /api/software/version/latest).
Upstream 1.5.3 only accepts the GitHub release of upstream as the answer: take the version from
the release page of our API server instead.
---
 src/common.rs | 22 +++++++++++++++-------
 1 file changed, 15 insertions(+), 7 deletions(-)

diff --git a/src/common.rs b/src/common.rs
index 4bc5bc2..c647dc5 100644
--- a/src/common.rs
+++ b/src/common.rs
@@ -1058,9 +1058,6 @@ pub fn is_modifier(evt: &KeyEvent) -> bool {
 }
 
 pub fn check_software_update() {
-    if is_custom_client() {
-        return;
-    }
     let opt = LocalConfig::get_option(keys::OPTION_ENABLE_CHECK_UPDATE);
     if config::option2bool(keys::OPTION_ENABLE_CHECK_UPDATE, &opt) {
         std::thread::spawn(move || allow_err!(do_check_software_update()));
@@ -1153,7 +1150,14 @@ fn clear_software_update_url() {
 fn process_software_update_check_response(bytes: Bytes) -> ResultType<()> {
     let resp: hbb_common::VersionCheckResponse = serde_json::from_slice(&bytes)?;
     let response_url = resp.url;
-    let release_id = release_id_from_update_url(&response_url)?;
+    // our API server answers with its own release page, `<api>/api/software/releases/tag/<version>`, not with the
+    // GitHub release of upstream that `release_id_from_update_url` accepts
+    let release_id = response_url
+        .trim_end_matches('/')
+        .rsplit('/')
+        .next()
+        .unwrap_or_default()
+        .to_owned();
     let latest_release_version = display_version_from_release_id(&release_id)?;
 
     if get_version_number(&latest_release_version) > get_version_number(crate::VERSION) {
@@ -1173,12 +1177,16 @@ fn process_software_update_check_response(bytes: Bytes) -> ResultType<()> {
     Ok(())
 }
 
-// No need to check `danger_accept_invalid_cert` for now.
-// Because the url is always `https://api.rustdesk.com/version/latest`.
+// The url is the one of our API server, which answers like api.rustdesk.com/version/latest.
 #[tokio::main(flavor = "current_thread")]
 pub async fn do_check_software_update() -> hbb_common::ResultType<()> {
-    let (request, url) =
+    let (request, _) =
         hbb_common::version_check_request(hbb_common::VER_TYPE_RUSTDESK_CLIENT.to_string());
+    let api = get_api_server("".to_owned(), "".to_owned());
+    if api.is_empty() {
+        return Ok(());
+    }
+    let url = format!("{}/api/software/version/latest", api);
     let proxy_conf = Config::get_socks();
     let tls_url = get_url_for_tls(&url, &proxy_conf);
     let tls_type = get_cached_tls_type(tls_url);
-- 
